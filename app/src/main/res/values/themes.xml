<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: Dark-only (no light theme) -->
    <style name="Theme.BlrsKeyboard" parent="Theme.AppCompat.NoActionBar">
        <!-- Obsidian backgrounds -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorBackgroundFloating">@color/bg_secondary</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        
        <!-- Accent -->
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        
        <!-- No action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
    </style>
</resources>
